# Copy to .env.local and fill in. Never commit .env.local.

# ---- Database (required) -----------------------------------------------
# Supabase: Dashboard > Connect > "Session pooler" string (IPv4 compatible).
# Looks like:
#   postgresql://postgres.xxxxx:PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres
# Amazon RDS later: just swap this one line.
DATABASE_URL=

# ---- App ----------------------------------------------------------------
PORT=8787
# Public URL, used in reminder emails. Leave blank until the site is live.
APP_URL=

# ---- Mail (leave SMTP_HOST empty to stay in DRY RUN) ---------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
MAIL_FROM=kenkou@morabu.com
ADMIN_EMAIL=

# ---- Feedback email (EmailJS, same template as the Gomi system) ----------
# From the EmailJS dashboard. The public key is safe in the frontend.
# Read at BUILD time, not at runtime — they must be set when `npm run build`
# runs, or the send is stripped out of the bundle.
# Template variables sent: subject, from_name, from_email, message,
# image_attached, to_email
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
# Who is notified — comma-separated, no spaces needed. Nothing is sent while
# this is empty.
VITE_EMAILJS_TO=
