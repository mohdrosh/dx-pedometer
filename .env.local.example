# Copy to .env.local and fill in. Never commit .env.local.

# ---- Database (required) -----------------------------------------------
# Supabase: Dashboard > Connect > "Session pooler" string (IPv4 compatible).
# Looks like:
#   postgresql://postgres.xxxxx:PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres
# Amazon RDS later: just swap this one line.
DATABASE_URL=

# ---- App ----------------------------------------------------------------
PORT=8787
# Public URL, used in reminder emails. Leave blank until the site is live.
APP_URL=

# ---- Mail (leave SMTP_HOST empty to stay in DRY RUN) ---------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
MAIL_FROM=kenkou@morabu.com
ADMIN_EMAIL=

# ---- Feedback email (EmailJS, same as the Gomi system) -------------------
# From the EmailJS dashboard. The public key is safe in the frontend.
# Template variables sent: name, email, employee_id, category, message, app_name
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
