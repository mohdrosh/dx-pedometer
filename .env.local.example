# Copy to .env.local and fill in. Never commit .env.local.

# ---- Database (required) -----------------------------------------------
# Supabase: Dashboard > Connect > "Session pooler" string (IPv4 compatible).
# Looks like:
#   postgresql://postgres.xxxxx:PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres
# Amazon RDS later: just swap this one line.
DATABASE_URL=

# ---- App ----------------------------------------------------------------
PORT=8787
# Public URL, used in reminder emails. Leave blank until the site is live.
APP_URL=

# ---- Mail (leave SMTP_HOST empty to stay in DRY RUN) ---------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
MAIL_FROM=kenkou@morabu.com
# モラエッグ only. Same server, same login, different sender — the
# pedometer's reminders keep coming from MAIL_FROM above. Unset it and
# モラエッグ falls back to MAIL_FROM, which is the thing to try first if
# the mail server refuses to send under this address.
EGG_MAIL_FROM=admin_egg@morabu.com
# On shared hosting the SMTP username IS the mailbox, so sending as
# admin_egg while signed in as kenkou is usually refused. Give モラエッグ
# the admin_egg mailbox's own login and it signs in as itself. Leave
# both empty to share the connection above.
EGG_SMTP_USER=
EGG_SMTP_PASS=
ADMIN_EMAIL=

# モラエッグの「不具合の報告」の送り先。サーバーから、上のSMTPで送る。
# カンマ区切りで複数指定できる（例: 担当者と健康対策委員会）。空欄なら
# ADMIN_EMAIL に送る。ADMIN_EMAIL は月曜のまとめや定期処理の通知も
# 受け取るので、不具合の報告だけ別の人に届けたいときはこちらを使う。
REPORT_EMAIL=

# ---- ログアウトで消すクッキーのパス --------------------------------------
# ふつうは空でよい。クッキーは「/」に置いているので、「/」を消せば終わる。
# 以前のビルドが Path を付けずに Set-Cookie を返していた場合だけ関係する。
# そのときブラウザはクッキーをリクエストのディレクトリ（/pedometer など）
# に紐づけて保存するので、「/」だけ消しても残り、ログアウトしたのに次の
# 読み込みでまた入ってしまう。既定では / と /pedometer と /pedometer/api
# と /egg を消す。別の場所で動かすときだけ、カンマ区切りで書く。
# 何も入っていないパスを消すのは、ブラウザが無視するだけで害はない。
COOKIE_PATHS=

# ---- Feedback email (EmailJS, same template as the Gomi system) ----------
# 万歩計のご意見フォームだけが使う。モラエッグの報告はサーバーから送る
# ため、これらが未設定でも届く。
# From the EmailJS dashboard. The public key is safe in the frontend.
# Read at BUILD time, not at runtime — they must be set when `npm run build`
# runs, or the send is stripped out of the bundle.
# Template variables sent: subject, from_name, from_email, message,
# image_attached, to_email
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
# Who is notified — comma-separated, no spaces needed. Nothing is sent while
# this is empty.
VITE_EMAILJS_TO=

# ---- 運賃検索（駅すぱあと API / ヴァル研究所） ---------------------------
# Fares on the 交通費精算書 are looked up rather than typed from memory, and
# the lookup is what tells 地下鉄 and JR apart between the same two stations.
# Needs a PAID plan: the free plan returns a link to a results page, not the
# fare itself. The buy-in packs sold through Amazon (5,000 / 10,000 / 20,000
# requests) are the cheapest way in and do not need a contract. They cannot
# call /search/course/extreme — src/fare.js falls back to
# /search/course/plain, which finds the same routes without timetable times
# and the same fares, which is all this asks for.
#   https://api-info.ekispert.com/plan/
# Leave this empty and the site simply hides the lookup — fares stay
# hand-typed, which is where they were before. Nothing else changes.
EKISPERT_API_KEY=
# Only for pointing the lookup at a stand-in while testing. Leave empty in
# production so it talks to the real service.
EKISPERT_BASE=
#
# Not required. 運賃表 (admin → 運賃表) holds the company's own approved
# fares and needs no key at all; the planner is only for a journey the
# table does not anticipate, such as a one-off trip to a client site.
